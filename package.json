{
  "name": "devchecks",
  "private": true,
  "version": "0.1.0",
  "description": "A family of small, independently published code-quality and security checkers usable from npm, a CLI, or a CDN.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/core",
    "packages/accesscheck",
    "packages/secretcheck",
    "packages/depcheck",
    "packages/pci-pagecheck",
    "packages/archcheck",
    "packages/safecodecheck",
    "packages/configcheck",
    "packages/perfcheck",
    "packages/apicontractcheck",
    "packages/licensecheck"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "cdn": "npm run build && node scripts/cdn.mjs",
    "release": "npm run check && node scripts/publish.mjs"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ravikiran476/devchecks.git"
  }
}
